{
  "name": "oku",
  "version": "3.9.7",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "audit:sudoku": "node scripts/audit-sudoku.mjs",
    "audit:sudoku:impossible": "node scripts/audit-impossible-sudoku.mjs",
    "mine:sudoku": "node scripts/mine-sudoku-catalog.mjs",
    "mine:sudoku:impossible": "node scripts/mine-impossible-catalog.mjs",
    "mine:sudoku:production": "node scripts/mine-sudoku-catalog.mjs --count=300 --start-seed=1000000 --max-attempts=100000 --format=seeds --output=data/sudoku-seed-catalog.json && node scripts/mine-impossible-catalog.mjs && node scripts/build-sudoku-level-catalog.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/app": "^6.0.3",
    "@capacitor/core": "^6.0.0",
    "@capacitor/haptics": "^6.0.0",
    "@capacitor/ios": "^6.0.0",
    "@capacitor/preferences": "^6.0.0",
    "@capacitor/screen-orientation": "^6.0.0",
    "@fontsource/outfit": "^5.2.8",
    "@revenuecat/purchases-capacitor": "^9.2.2",
    "framer-motion": "^11.0.0",
    "lucide-react": "^0.300.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.3",
    "vite": "^5.3.1"
  }
}
